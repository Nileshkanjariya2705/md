# ==============================================================================
# Magnovaa Technology - Environment Variables
# ==============================================================================
# Copy this file to .env.local for local development or set in your deployment
# platform (e.g. Vercel, Netlify, Cloudflare, Firebase App Hosting, AWS Amplify).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Website URL
# ------------------------------------------------------------------------------
# Used for canonical SEO URLs, sitemap.xml, robots.txt, and Open Graph previews.
# Local Development: http://localhost:3000
# Production: https://your-production-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Firebase Cloud Configuration
# ------------------------------------------------------------------------------
# Create a project at https://console.firebase.google.com
# Go to Project Settings -> General -> Your apps -> Web app -> SDK setup and configuration.
# When these are set, the app will automatically synchronize Projects, Team Members,
# Client Reviews, Messages, and Pricing Plans with Cloud Firestore & Firebase Auth.
# (If omitted, the app will smoothly run in local fallback/demo mode with mock data).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 3. Security & Admin Notes
# ------------------------------------------------------------------------------
# To access the admin panel in disguise mode, navigate to:
# /mitali or /dharmesh to obtain operator session cookies and enter /admin/login.
